direction: down

title: |md
  Data Flow
|

# --- Ingest Path ---

ingest: Ingest Path {
  style.fill: "#fff3e0"
  style.stroke: "#e65100"
  style.font-color: "#e65100"
  style.bold: true

  step1: 1. Fetch stores from\nVusion Manager API {
    shape: step
    style.fill: "#ffe0b2"
  }
  step2: 2. For each store, fetch\nproducts, labels, access points\nfrom VLink API {
    shape: step
    style.fill: "#ffe0b2"
  }
  step3: 3. Normalise records\n(snake_case, remove internal fields) {
    shape: step
    style.fill: "#ffe0b2"
  }
  step4: 4. Batch upsert\ninto PostgreSQL {
    shape: step
    style.fill: "#ffe0b2"
  }
  step5: 5. Record sync state\nper store {
    shape: step
    style.fill: "#ffe0b2"
  }

  step1 -> step2 -> step3 -> step4 -> step5
}

sync_decision: Sync Mode Decision {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
  style.font-color: "#1565c0"
  style.bold: true

  check: Check store_sync_state\nfor last successful run {
    shape: diamond
    style.fill: "#bbdefb"
  }
  full: Full Sync\n(fetch all records) {
    shape: step
    style.fill: "#c8e6c9"
  }
  incremental: Incremental Sync\n(fetch modified since\nlast run - lookback window) {
    shape: step
    style.fill: "#c8e6c9"
  }

  check -> full: no previous run
  check -> incremental: previous run found
}

# --- Serve Path ---

serve: Serve Path {
  style.fill: "#f3e5f5"
  style.stroke: "#6a1b9a"
  style.font-color: "#6a1b9a"
  style.bold: true

  req: "1. Consumer sends\nPOST /v1/{entity}" {
    shape: step
    style.fill: "#e1bee7"
  }
  validate: 2. Validate request\nagainst entity registry {
    shape: step
    style.fill: "#e1bee7"
  }
  query: 3. Build parameterised\nSQL query {
    shape: step
    style.fill: "#e1bee7"
  }
  respond: 4. Return paginated\nJSON response {
    shape: step
    style.fill: "#e1bee7"
  }

  req -> validate -> query -> respond
}

ingest -> sync_decision: determines mode\nfor next run {
  style.stroke-dash: 3
  style.stroke: "#616161"
}
sync_decision -> ingest.step2: feeds into {
  style.stroke-dash: 3
  style.stroke: "#616161"
}
