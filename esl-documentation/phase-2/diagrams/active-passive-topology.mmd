flowchart TB
    Ingress[/"Ingress / load balancer"\]

    subgraph Active["Active cluster — clusterName == activeCluster"]
        direction TB
        A_DP["<b>datapipeline CronJob</b><br/>suspend: false<br/>✓ scheduled runs fire"]
        A_DF["<b>datafetch Deployment</b><br/>active/active<br/>✓ serves traffic"]
        A_EP["<b>event-publisher Deployment</b><br/>active/active<br/>✓ polls outbox + publishes"]
    end

    subgraph Passive["Passive cluster — clusterName != activeCluster"]
        direction TB
        P_DP["datapipeline CronJob<br/>suspend: true<br/>✕ never fires"]
        P_DF["<b>datafetch Deployment</b><br/>active/active<br/>✓ serves traffic"]
        P_EP["<b>event-publisher Deployment</b><br/>active/active<br/>✓ polls outbox + publishes"]
    end

    DB[("PostgreSQL<br/>shared per environment")]
    Solace(["Solace broker"])

    Ingress --> A_DF
    Ingress --> P_DF
    A_DP -.->|writes| DB
    A_DF -.->|reads| DB
    P_DF -.->|reads| DB
    A_EP -.->|polls| DB
    P_EP -.->|polls| DB
    A_EP -.->|publishes| Solace
    P_EP -.->|publishes| Solace

    Failover["<b>Failover</b><br/>flip activeCluster value in env values file<br/>→ datapipeline swaps roles<br/>datafetch and event-publisher are unaffected (active/active)"]

    classDef active fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    classDef suspended fill:#f5f5f5,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 5,color:#9e9e9e
    classDef external fill:#fff8dc,stroke:#c0a000
    classDef note fill:#fff,stroke:#666,stroke-dasharray:5 5
    class A_DP,A_DF,A_EP active
    class P_DF,P_EP active
    class P_DP suspended
    class DB,Solace,Ingress external
    class Failover note
