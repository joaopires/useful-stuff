erDiagram
    STORES ||--o{ PRODUCTS       : "has"
    STORES ||--o{ LABELS         : "has"
    STORES ||--o{ ACCESS_POINTS  : "has"

    EVENT_OUTBOX }o..|| STORES        : "entity_key (logical)"
    EVENT_OUTBOX }o..|| PRODUCTS      : "entity_key (logical)"
    EVENT_OUTBOX }o..|| LABELS        : "entity_key (logical)"
    EVENT_OUTBOX }o..|| ACCESS_POINTS : "entity_key (logical)"

    STORES {
        varchar  retail_chain_id       PK
        varchar  store_id              PK
        varchar  store_name
        varchar  retail_chain_name
        timestamptz creation_date
        timestamptz modification_date
        timestamptz created_at
        timestamptz last_updated_at
    }

    PRODUCTS {
        varchar  retail_chain_id  PK,FK
        varchar  store_id         PK,FK
        varchar  item_id          PK
        varchar  name
        varchar  status
        numeric  price
        timestamptz creation_date
        timestamptz modification_date
        timestamptz deletion_date     "Phase 2: from Vusion (nullable)"
        timestamptz created_at
        timestamptz last_updated_at
        timestamptz deleted_at        "Phase 2: audit (nullable)"
    }

    LABELS {
        varchar  retail_chain_id  PK,FK
        varchar  store_id         PK,FK
        varchar  label_id         PK
        varchar  transmitter_id
        varchar  status
        timestamptz creation_date
        timestamptz modification_date
        timestamptz deletion_date     "Phase 2: informational (often NULL)"
        timestamptz created_at
        timestamptz last_updated_at
        timestamptz deleted_at        "Phase 2: audit (nullable)"
    }

    ACCESS_POINTS {
        varchar  retail_chain_id  PK,FK
        varchar  store_id         PK,FK
        varchar  id               PK
        varchar  mac_address
        varchar  serial_number
        varchar  status
        timestamptz creation_date
        timestamptz modification_date
        timestamptz created_at
        timestamptz last_updated_at
    }

    EVENT_OUTBOX {
        uuid        id            PK
        varchar     event_type        "CREATED | UPDATED | DELETED"
        varchar     entity_type       "store | product | label | accesspoint"
        jsonb       entity_key
        jsonb       payload           "diff | snapshot | empty for DELETED"
        timestamptz occurred_at
        text        status            "PENDING | DELIVERED | FAILED"
        timestamptz delivered_at
    }

    %% Operational tables (run + per-store sync state, error log).
    %% No FK constraints between these — see 03-database.md for rationale.
    SYNC_STATE         ||..o{ STORE_SYNC_STATE     : "run_id (logical, no FK)"
    SYNC_STATE         ||..o{ RECORDS_WITH_ERRORS  : "run_id (logical, no FK)"

    SYNC_STATE {
        bigint      id                       PK
        varchar     pipeline_name
        varchar     sync_status              "running | success | failed | cancelled"
        bigint      stores_processed
        bigint      products_processed
        bigint      labels_processed
        bigint      access_points_processed
        interval    duration
        timestamptz started_at
        timestamptz finished_at
        text        error_message
    }

    STORE_SYNC_STATE {
        bigint      id                       PK
        bigint      run_id                       "logical → sync_state.id"
        varchar     pipeline_name
        varchar     retail_chain_id              "Phase 2 (V1.0.0.15)"
        varchar     store_id
        varchar     sync_status              "success | failed | cancelled"
        bigint      products_processed
        bigint      labels_processed
        bigint      access_points_processed
        timestamptz synced_at
        text        error_message
    }

    RECORDS_WITH_ERRORS {
        serial      id                       PK
        bigint      run_id                       "logical → sync_state.id (V1.0.0.22, nullable)"
        varchar     retail_chain_id              "V1.0.0.22 (nullable)"
        varchar     store_id                     "V1.0.0.22 (nullable)"
        varchar     pipeline_name                "V1.0.0.22 (nullable)"
        varchar     entity_type                  "V1.0.0.22 (nullable)"
        text        table_name
        text        record_id
        text        sync_mode
        text        error_type
        text        error_message
        text        detail
        text        pg_error_code
        text        data
        timestamptz created_at
    }
