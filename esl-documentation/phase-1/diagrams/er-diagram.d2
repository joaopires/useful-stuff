direction: down

title: {
  label: "esl schema — Entity Relationships"
  style.font-size: 24
  style.bold: true
  style.underline: true
  shape: text
}

# Entity Data

stores: stores {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
  style.bold: true

  shape: sql_table

  retail_chain_id: VARCHAR(50) {constraint: PK}
  store_id: VARCHAR(50) {constraint: PK}
  store_name: VARCHAR(100)
  retail_chain_name: VARCHAR(100)
  software_setting_*: VARCHAR
  creation_date: TIMESTAMPTZ
  modification_date: TIMESTAMPTZ
  created_at: TIMESTAMPTZ
  last_updated_at: TIMESTAMPTZ
}

access_points: access_points {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
  style.bold: true

  shape: sql_table

  retail_chain_id: VARCHAR(50) {constraint: "PK, FK"}
  store_id: VARCHAR(50) {constraint: "PK, FK"}
  id: VARCHAR(50) {constraint: PK}
  mac_address: VARCHAR(50) {constraint: unique}
  serial_number: VARCHAR(100) {constraint: unique}
  channel: VARCHAR(10)
  status: VARCHAR(50)
  connectivity_*: "VARCHAR / TIMESTAMPTZ"
  creation_date: TIMESTAMPTZ
  modification_date: TIMESTAMPTZ
}

products: products {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
  style.bold: true

  shape: sql_table

  retail_chain_id: VARCHAR(50) {constraint: "PK, FK"}
  store_id: VARCHAR(50) {constraint: "PK, FK"}
  item_id: VARCHAR(50) {constraint: PK}
  name: VARCHAR(255)
  description: TEXT
  brand: VARCHAR(100)
  price: "NUMERIC(12,2)"
  references: "TEXT[]"
  status: VARCHAR(300)
  matching_*: "INTEGER / BOOLEAN / TEXT[]"
  custom_*: "VARCHAR (30+ fields)"
  creation_date: TIMESTAMPTZ
  modification_date: TIMESTAMPTZ
}

labels: labels {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
  style.bold: true

  shape: sql_table

  label_id: VARCHAR(50) {constraint: PK}
  store_id: VARCHAR(50) {constraint: "PK, FK"}
  retail_chain_id: VARCHAR(50) {constraint: "PK, FK"}
  transmitter_id: VARCHAR(50)
  status: VARCHAR(50)
  hardware_*: VARCHAR
  package_*: "VARCHAR / TIMESTAMPTZ"
  transmission_*: TIMESTAMPTZ
  matching_*: "VARCHAR / TEXT[]"
  connectivity_*: "VARCHAR / TIMESTAMPTZ"
  creation_date: TIMESTAMPTZ
  modification_date: TIMESTAMPTZ
}

# Sync State

sync_state: sync_state {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
  style.bold: true

  shape: sql_table

  id: BIGSERIAL {constraint: PK}
  pipeline_name: VARCHAR(255)
  sync_status: VARCHAR(20)
  stores_processed: BIGINT
  products_processed: BIGINT
  labels_processed: BIGINT
  access_points_processed: BIGINT
  duration: INTERVAL
  started_at: TIMESTAMPTZ
  finished_at: TIMESTAMPTZ
}

store_sync_state: store_sync_state {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
  style.bold: true

  shape: sql_table

  id: BIGSERIAL {constraint: PK}
  run_id: BIGINT
  pipeline_name: VARCHAR(255)
  store_id: VARCHAR(255)
  sync_status: VARCHAR(20)
  products_processed: BIGINT
  labels_processed: BIGINT
  access_points_processed: BIGINT
  synced_at: TIMESTAMPTZ
}

# Error Tracking

records_with_errors: records_with_errors {
  style.fill: "#ffebee"
  style.stroke: "#c62828"
  style.bold: true

  shape: sql_table

  id: SERIAL {constraint: PK}
  table_name: TEXT
  record_id: TEXT
  sync_mode: TEXT
  error_type: TEXT
  error_message: TEXT
  pg_error_code: TEXT
  data: TEXT
  created_at: TIMESTAMPTZ
}

# Relationships

stores <-- access_points: FK (retail_chain_id, store_id) {
  style.stroke: "#2e7d32"
}
stores <-- products: FK (retail_chain_id, store_id) {
  style.stroke: "#2e7d32"
}
stores <-- labels: FK (retail_chain_id, store_id) {
  style.stroke: "#2e7d32"
}

# Retention note
retention_note: {
  label: "⟳ sync_state and store_sync_state\nautomatically retain last 20 rows per key\nvia AFTER INSERT triggers"
  shape: text
  style.font-size: 14
  style.font-color: "#616161"
}

sync_state -- retention_note: {style.stroke-dash: 3; style.stroke: "#9e9e9e"}
store_sync_state -- retention_note: {style.stroke-dash: 3; style.stroke: "#9e9e9e"}
